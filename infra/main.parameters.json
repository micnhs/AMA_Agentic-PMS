{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION=swedencentral}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "principalType": {
      "value": "${AZURE_PRINCIPAL_TYPE=User}"
    },
    "deployerEmail": {
      "value": "${DEPLOYER_EMAIL}"
    },
    "alertRecipients": {
      "value": "${ALERT_RECIPIENTS=}"
    },
    "existingEntraAppClientId": {
      "value": "${ENTRA_EXISTING_APP_CLIENT_ID=}"
    },
    "existingEntraAppIdentifierUri": {
      "value": "${ENTRA_EXISTING_APP_IDENTIFIER_URI=}"
    },
    "useGeneralModelForAll": {
      "value": "${MODEL_FALLBACK_ALL_GENERAL=false}"
    },
    "modelDeploymentSku": {
      "value": "${MODEL_DEPLOYMENT_SKU=DataZoneStandard}"
    },
    "analysisModelCapacity": {
      "value": "${MODEL_ANALYSIS_CAPACITY=50}"
    },
    "generalModelCapacity": {
      "value": "${MODEL_GENERAL_CAPACITY=50}"
    },
    "customContentFilter": {
      "value": "${CUSTOM_CONTENT_FILTER=true}"
    },
    "searchSku": {
      "value": "${AZURE_SEARCH_SKU=basic}"
    },
    "budgetAmount": {
      "value": "${BUDGET_USD=250}"
    },
    "budgetStartDate": {
      "value": "${BUDGET_START_DATE=}"
    },
    "webMinReplicas": {
      "value": "${WEB_MIN_REPLICAS=0}"
    },
    "workerHealthProbes": {
      "value": "${WORKER_HEALTH_PROBES=true}"
    },
    "previewMonitoring": {
      "value": "${PREVIEW_MONITORING=false}"
    },
    "webExists": {
      "value": "${SERVICE_WEB_RESOURCE_EXISTS=false}"
    },
    "workerExists": {
      "value": "${SERVICE_WORKER_RESOURCE_EXISTS=false}"
    },
    "storageSku": {
      "value": "${AZURE_STORAGE_SKU=Standard_LRS}"
    },
    "logRetentionDays": {
      "value": "${LOG_RETENTION_DAYS=30}"
    },
    "logDailyCapGb": {
      "value": "${LOG_DAILY_CAP_GB=1}"
    }
  }
}
