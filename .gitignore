# Local runtime data (SQLite databases, outbox, logs, golden summaries)
var/
outbox/

# Python
__pycache__/
*.pyc
.venv/

# Azure smoke-test output and the other Gate C hand-over files (copied out deliberately; never commit)
smoke-test-result.json
/smoke-test-result-part1.json
/deploy.log
/notes.md
/screenshot-*.png

# Azure Developer CLI environments (hold deployment outputs; never commit)
.azure/

# Local secrets files must never be committed
.env
.env.*

# CI and test artifacts
artifacts/
playwright-report/
test-results/
.pytest_cache/
.ruff_cache/
